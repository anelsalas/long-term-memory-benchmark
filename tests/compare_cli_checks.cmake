cmake_minimum_required(VERSION 3.20)

foreach(required IN ITEMS LTM_COMPARE_EXE LTM_SOURCE_DIR LTM_TEST_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Define ${required} for CLI acceptance")
  endif()
endforeach()
if(NOT EXISTS "${LTM_COMPARE_EXE}")
  message(FATAL_ERROR "Build ltm-compare before running CLI acceptance")
endif()
get_filename_component(test_root "${LTM_TEST_DIR}" ABSOLUTE)
get_filename_component(source_root "${LTM_SOURCE_DIR}" ABSOLUTE)
if(test_root STREQUAL source_root)
  message(FATAL_ERROR "LTM_TEST_DIR must be a separate build/test directory")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(work "${test_root}/compare-acceptance-${nonce}")
set(output "${work}/artifacts")
file(MAKE_DIRECTORY "${work}")
file(TO_CMAKE_PATH "${output}" output)
set(env_name "LTM_ACCEPTANCE_UNUSED_KEY_${nonce}")
unset(ENV{${env_name}})

function(require_json_value document expected)
  string(JSON actual ERROR_VARIABLE error GET "${document}" ${ARGN})
  if(error OR NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "Unexpected JSON value at ${ARGN}: expected '${expected}'")
  endif()
endfunction()

function(require_json_type document expected)
  string(JSON actual ERROR_VARIABLE error TYPE "${document}" ${ARGN})
  if(error OR NOT actual STREQUAL expected)
    message(FATAL_ERROR "Unexpected JSON type at ${ARGN}: expected '${expected}'")
  endif()
endfunction()

function(require_member_count document expected)
  string(JSON actual ERROR_VARIABLE error LENGTH "${document}" ${ARGN})
  if(error OR NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "Unexpected JSON member count at ${ARGN}")
  endif()
endfunction()

function(extract_candidate prompt result_variable)
  string(FIND "${prompt}" "{" start)
  string(LENGTH "${prompt}" size)
  if(start LESS 0)
    message(FATAL_ERROR "Reader prompt requires a JSON candidate object")
  endif()
  set(depth 0)
  set(in_string FALSE)
  set(escaped FALSE)
  math(EXPR last "${size}-1")
  foreach(position RANGE ${start} ${last})
    string(SUBSTRING "${prompt}" ${position} 1 character)
    if(in_string)
      if(escaped)
        set(escaped FALSE)
      elseif(character STREQUAL "\\")
        set(escaped TRUE)
      elseif(character STREQUAL "\"")
        set(in_string FALSE)
      endif()
    elseif(character STREQUAL "\"")
      set(in_string TRUE)
    elseif(character STREQUAL "{")
      math(EXPR depth "${depth}+1")
    elseif(character STREQUAL "}")
      math(EXPR depth "${depth}-1")
      if(depth EQUAL 0)
        math(EXPR length "${position}-${start}+1")
        string(SUBSTRING "${prompt}" ${start} ${length} candidate)
        set(${result_variable} "${candidate}" PARENT_SCOPE)
        return()
      endif()
    endif()
  endforeach()
  message(FATAL_ERROR "Reader candidate object is incomplete")
endfunction()

set(config [=[{
  "schema_version":1,
  "source_revision":"cli-acceptance-development",
  "endpoint_url":"https://example.invalid/v1/chat/completions",
  "api_key_env":"@env_name@",
  "reader":{"id":"acceptance-reader","version":"acceptance-reader-v1"},
  "judge":{"id":"acceptance-judge","version":"acceptance-judge-v1"},
  "provider_policy":{
    "max_requests":"0","max_tokens":"0","max_cost_nanos":"0",
    "input_token_price_nanos":"1","output_token_price_nanos":"1",
    "request_price_nanos":"0","max_prompt_bytes":"262144",
    "max_response_bytes":"4096","max_attempts":1
  },
  "input_token_upper_bound":"100000","context_token_limit":"100000",
  "output_token_limit":"64","judge_output_token_limit":"10",
  "seed":"42","top_k":3,"timeout_ms":1000,
  "output_token_parameter":"max_tokens","temperature":0,
  "output_directory":"@output@",
  "chat_framing_token_allowance":256,"tokenizer_bound_verified":true,
  "max_candidate_answer_bytes":2048
}]=])
string(CONFIGURE "${config}" config @ONLY)
set(config_path "${work}/fresh-zero-budget.json")
file(WRITE "${config_path}" "${config}")

function(run_dry config_file result_variable)
  execute_process(COMMAND "${LTM_COMPARE_EXE}" --config "${config_file}" --dry-run
    RESULT_VARIABLE code OUTPUT_VARIABLE result ERROR_VARIABLE diagnostics TIMEOUT 20)
  if(NOT "${code}" STREQUAL "0")
    message(FATAL_ERROR "Fresh CLI dry-run failed: ${code}; ${diagnostics}")
  endif()
  require_json_value("${result}" "dry_run_plan" run_kind)
  require_json_value("${result}" "0" provider_requests_made)
  require_json_value("${result}" "2" planned_requests)
  require_json_type("${result}" "NULL" model_accuracy)
  set(${result_variable} "${result}" PARENT_SCOPE)
endfunction()

run_dry("${config_path}" first)
string(JSON artifact GET "${first}" artifact_directory)
file(TO_CMAKE_PATH "${artifact}" artifact)
get_filename_component(artifact_parent "${artifact}" DIRECTORY)
if(NOT artifact_parent STREQUAL output OR NOT IS_DIRECTORY "${artifact}")
  message(FATAL_ERROR "CLI artifacts must stay under the assigned test output")
endif()
foreach(name IN ITEMS manifest.json plan.json evaluator-gold.json)
  if(NOT EXISTS "${artifact}/${name}")
    message(FATAL_ERROR "Missing dry-run artifact ${name}")
  endif()
endforeach()
file(READ "${artifact}/plan.json" plan)
file(READ "${artifact}/manifest.json" manifest)
file(READ "${artifact}/evaluator-gold.json" gold)
require_json_value("${plan}" "dry_run_plan" run_kind)
require_json_value("${plan}" "0" provider_requests_made)
require_json_value("${plan}" "2" planned_reader_requests)
require_json_value("${plan}" "0" planned_judge_requests)
require_member_count("${plan}" 2 cases)
require_member_count("${manifest}" 2 case_ids)
require_json_value("${manifest}" "fresh:full_history" case_ids 0)
require_json_value("${manifest}" "fresh:retrieved_evidence" case_ids 1)
require_json_value("${plan}" "full_history" cases 0 condition)
require_json_value("${plan}" "retrieved_evidence" cases 1 condition)
require_member_count("${gold}" 1)
require_json_value("${gold}" "fresh" 0 source)
require_json_type("${gold}" "STRING" 0 gold_answer)

foreach(index IN ITEMS 0 1)
  set(candidate_sources "")
  string(JSON prompt GET "${plan}" cases ${index} prompt)
  string(JSON prompt_hash GET "${plan}" cases ${index} prompt_sha256)
  string(SHA256 actual_hash "${prompt}")
  if(NOT prompt_hash STREQUAL actual_hash)
    message(FATAL_ERROR "Reader prompt hash differs from actual planned bytes")
  endif()
  extract_candidate("${prompt}" candidate)
  require_json_type("${candidate}" "OBJECT")
  require_member_count("${candidate}" 4)
  require_json_type("${candidate}" "STRING" case_id)
  require_json_type("${candidate}" "STRING" question)
  require_json_type("${candidate}" "STRING" question_date)
  require_json_type("${candidate}" "ARRAY" sessions)
  string(JSON session_count LENGTH "${candidate}" sessions)
  if(session_count LESS 1)
    message(FATAL_ERROR "Fixture reader input should include source evidence")
  endif()
  math(EXPR last_session "${session_count}-1")
  foreach(session RANGE 0 ${last_session})
    require_member_count("${candidate}" 3 sessions ${session})
    require_json_type("${candidate}" "STRING" sessions ${session} date)
    require_json_type("${candidate}" "ARRAY" sessions ${session} messages)
    string(JSON source GET "${candidate}" sessions ${session} source_id)
    if(NOT source MATCHES "^session-[0-9]+$")
      message(FATAL_ERROR "Session IDs must be opaque runtime identities")
    endif()
    string(JSON message_count LENGTH "${candidate}" sessions ${session} messages)
    if(message_count LESS 1)
      message(FATAL_ERROR "Fixture sessions require source messages")
    endif()
    math(EXPR last_message "${message_count}-1")
    foreach(message RANGE 0 ${last_message})
      require_member_count("${candidate}" 3 sessions ${session} messages ${message})
      require_json_value("${candidate}" "user" sessions ${session} messages ${message} role)
      require_json_type("${candidate}" "STRING" sessions ${session} messages ${message} content)
      string(JSON message_source GET "${candidate}" sessions ${session} messages ${message} source_id)
      if(NOT message_source MATCHES "^session-[0-9]+/message-[0-9]+$")
        message(FATAL_ERROR "Message IDs must be opaque runtime identities")
      endif()
      list(APPEND candidate_sources "${message_source}")
    endforeach()
  endforeach()
  string(JSON source_count LENGTH "${plan}" cases ${index} source_ids)
  list(LENGTH candidate_sources candidate_source_count)
  if(source_count LESS 1 OR NOT source_count EQUAL candidate_source_count)
    message(FATAL_ERROR "Planned source count must match actual reader evidence")
  endif()
  set(planned_sources "")
  math(EXPR last_source "${source_count}-1")
  foreach(source RANGE 0 ${last_source})
    string(JSON source_id GET "${plan}" cases ${index} source_ids ${source})
    list(APPEND planned_sources "${source_id}")
  endforeach()
  list(SORT candidate_sources)
  list(SORT planned_sources)
  if(NOT "${candidate_sources}" STREQUAL "${planned_sources}")
    message(FATAL_ERROR "Planned source IDs differ from serialized candidate evidence")
  endif()
endforeach()
if(EXISTS "${artifact}/summary.json" OR EXISTS "${artifact}/results.json")
  message(FATAL_ERROR "Dry-run must retain planned state rather than fabricated model results")
endif()

foreach(name IN ITEMS manifest.json plan.json evaluator-gold.json)
  string(MAKE_C_IDENTIFIER "${name}" key)
  file(SHA256 "${artifact}/${name}" first_${key})
endforeach()
run_dry("${config_path}" second)
string(JSON second_artifact GET "${second}" artifact_directory)
file(TO_CMAKE_PATH "${second_artifact}" second_artifact)
if(second_artifact STREQUAL artifact)
  message(FATAL_ERROR "Repeated dry-run must create a collision-safe run directory")
endif()
foreach(name IN ITEMS manifest.json plan.json evaluator-gold.json)
  string(MAKE_C_IDENTIFIER "${name}" key)
  file(SHA256 "${artifact}/${name}" preserved)
  if(NOT "${preserved}" STREQUAL "${first_${key}}")
    message(FATAL_ERROR "Existing artifact changed after a repeated run")
  endif()
endforeach()

file(GLOB before_execute LIST_DIRECTORIES true "${output}/*")
execute_process(COMMAND "${LTM_COMPARE_EXE}" --config "${config_path}" --execute
  RESULT_VARIABLE execute_code OUTPUT_VARIABLE execute_output ERROR_VARIABLE execute_error TIMEOUT 20)
if(NOT "${execute_code}" STREQUAL "2")
  message(FATAL_ERROR "Zero-budget execute must fail before dispatch")
endif()
require_json_value("${execute_output}" "command_error" run_kind)
require_json_value("${execute_output}" "execute_budget_gate" stage)
require_json_type("${execute_output}" "NULL" artifact_directory)
if(NOT execute_error MATCHES "execute_budget_gate")
  message(FATAL_ERROR "Expected explicit budget gate before credential lookup")
endif()
file(GLOB after_execute LIST_DIRECTORIES true "${output}/*")
if(NOT "${before_execute}" STREQUAL "${after_execute}")
  message(FATAL_ERROR "Zero-budget execute created artifacts before passing preflight")
endif()

file(WRITE "${work}/malformed.json" "{malformed configuration")
execute_process(COMMAND "${LTM_COMPARE_EXE}" --config "${work}/malformed.json" --dry-run
  RESULT_VARIABLE invalid_code OUTPUT_VARIABLE invalid_output ERROR_VARIABLE invalid_error TIMEOUT 20)
if(NOT "${invalid_code}" STREQUAL "2")
  message(FATAL_ERROR "Malformed configuration must fail with no success JSON")
endif()
require_json_value("${invalid_output}" "command_error" run_kind)
require_json_type("${invalid_output}" "NULL" artifact_directory)

set(occupied "${work}/occupied-output")
file(WRITE "${occupied}" "preserve-existing-file")
string(JSON occupied_config SET "${config}" output_directory "\"${occupied}\"")
file(WRITE "${work}/occupied-config.json" "${occupied_config}")
execute_process(COMMAND "${LTM_COMPARE_EXE}" --config "${work}/occupied-config.json" --dry-run
  RESULT_VARIABLE occupied_code OUTPUT_VARIABLE occupied_output ERROR_VARIABLE occupied_error TIMEOUT 20)
file(READ "${occupied}" occupied_bytes)
if(NOT "${occupied_code}" STREQUAL "2" OR
   NOT occupied_bytes STREQUAL "preserve-existing-file")
  message(FATAL_ERROR "Occupied output file must be preserved with explicit failure")
endif()
require_json_value("${occupied_output}" "command_error" run_kind)
message(STATUS "PASS CLI acceptance: paired dry-run, zero dispatch, isolated evaluator gold, budgets, malformed input and collision-safe artifacts")

# Four controls use the same candidate and keep oracle evidence explicit.
string(JSON controls SET "${config}" conditions "[\"no_memory\",\"full_history\",\"retrieved_evidence\",\"known_evidence\"]")
file(WRITE "${work}/controls.json" "${controls}")
execute_process(COMMAND "${LTM_COMPARE_EXE}" --config "${work}/controls.json" --dry-run
  RESULT_VARIABLE control_code OUTPUT_VARIABLE control_result)
if(NOT control_code EQUAL 0)
  message(FATAL_ERROR "Four-condition planning failed")
endif()
require_json_value("${control_result}" "4" planned_requests)
string(JSON control_dir GET "${control_result}" artifact_directory)
file(READ "${control_dir}/plan.json" control_plan)
require_member_count("${control_plan}" 0 cases 0 source_ids)
require_member_count("${control_plan}" 1 cases 3 source_ids)
string(JSON oracle_prompt GET "${control_plan}" cases 3 prompt)
if(NOT oracle_prompt MATCHES "corrected to")
  message(FATAL_ERROR "Known evidence must contain the actual correction record")
endif()
string(JSON empty_prompt GET "${control_plan}" cases 0 prompt)
extract_candidate("${empty_prompt}" empty_candidate)
require_member_count("${empty_candidate}" 0 sessions)
string(JSON invalid_conditions SET "${config}" conditions "[\"no_memory\",\"no_memory\"]")
file(WRITE "${work}/invalid-controls.json" "${invalid_conditions}")
execute_process(COMMAND "${LTM_COMPARE_EXE}" --config "${work}/invalid-controls.json" --dry-run
  RESULT_VARIABLE duplicate_code OUTPUT_QUIET ERROR_QUIET)
if(NOT duplicate_code EQUAL 2)
  message(FATAL_ERROR "Repeated controls must be rejected")
endif()
